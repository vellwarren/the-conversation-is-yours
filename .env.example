# The demo starts safely with two deterministic fake runtimes.
PORT=8787
DATA_FILE=./data/state.json
DEFAULT_RUNTIME=fake-api

# Real Messages API runtime. It is used only when a request explicitly asks
# for runtime "api". There is no automatic paid fallback.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_VERSION=2023-06-01

# Real Claude Code runtime. Keep this config home isolated from API keys.
CLAUDE_BIN=claude
CLAUDE_MODEL=
CLAUDE_CONFIG_DIR=
CLAUDE_HOME_DIR=
CLAUDE_SPAWN_CWD=
CLAUDE_MCP_URL=http://127.0.0.1:8788/mcp
CLAUDE_MCP_TOKEN=replace-with-a-long-random-demo-token
CLAUDE_TIMEOUT_MS=300000

# Toy MCP server. It is a separate process by design.
MCP_PORT=8788
MCP_TOKEN=replace-with-a-long-random-demo-token
